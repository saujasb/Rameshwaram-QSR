# Copy this file to client/.env.local for local development.
# Not needed in production: client and API are one Vercel project (see
# /vercel.json), so the same-origin "/api" default is used automatically.
# Only set this if the API is ever split into its own deployment.
VITE_API_BASE_URL=

# No Supabase keys are needed in the browser. The dashboard signs in through
# the /api (HttpOnly session cookies), and Realtime is off (see
# src/lib/supabaseClient.ts). Never put a service-role key or any other
# secret in a VITE_* variable -- everything VITE_* is bundled into the
# public JavaScript.
