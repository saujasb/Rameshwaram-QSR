# Copy this file to client/.env.local for local development.
# Not needed in production: client and API are one Vercel project (see
# /vercel.json), so the same-origin "/api" default is used automatically.
# Only set this if the API is ever split into its own deployment.
VITE_API_BASE_URL=

# --- Supabase Realtime (Live Sales feed) ---
# Safe to expose to the browser: this is the publishable/anon key, NOT the
# service-role key (server/.env.example has that one, server-only). It can
# only read what provider_orders' read-only RLS policy allows (SELECT), and
# nothing else -- see the "Dashboard read-only access" policy.
# Project Settings -> API -> Project URL / Publishable key.
# If left unset, the Live Feed / Sales Amount tab fall back to polling instead
# of pushed Realtime updates -- the page still works, just less instantly.
VITE_SUPABASE_URL=https://rcysbawgqgdfjwqqwjyg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_P5tjaGZFhdPzyZkX6_R4hw_L8lNajZj
