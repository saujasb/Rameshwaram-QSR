# Copy this file to client/.env.local for local development against a
# deployed backend instead of the local dev server proxy (vite.config.ts
# proxies /api to http://localhost:4300 by default, so most local dev needs
# no VITE_API_BASE_URL at all -- see client/src/lib/api/client.ts).
#
# Stage 4 (Vercel): on Vercel, the frontend and the /api serverless function
# are served from the SAME origin (see vercel.json's /api rewrite), and
# client/src/lib/api/{client,datasets,sales}.ts already default to the
# relative path "/api" when VITE_API_BASE_URL is unset. Do NOT set
# VITE_API_BASE_URL in the Vercel project's environment variables --
# leaving it unset is what makes the frontend call same-origin "/api/...".
#
# This variable remains useful as an explicit override for local development
# or testing against a *different* deployed backend (e.g. the still-live
# Render service during the migration window):
# In Netlify's production build (unaffected by Stage 4; see netlify.toml),
# this is set as a Netlify build environment variable (Site settings ->
# Environment variables) pointing at the Render backend, not committed here.
VITE_API_BASE_URL=https://rameshwaram-qsr-server.onrender.com/api
