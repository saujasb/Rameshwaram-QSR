# Copy this file to server/.env for local development.
# In production, set these as Vercel project environment variables instead --
# never commit a real .env file with actual secrets.

# --- Supabase (required) ---
# Project Settings -> API. Service role key bypasses RLS -- every table here
# has RLS enabled with no policies, so this is the only key that can read/write
# them server-side. Never expose it to the browser or a VITE_-prefixed var.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> Transaction pooler
# (port 6543). Used by the sales/datasets/provider-orders modules' raw SQL.
SUPABASE_DB_URL=postgresql://postgres.your-project:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Local dev only (Vercel does not need this) ---
PORT=4300

# --- CORS ---
# Comma-separated list of allowed origins for cross-origin API calls. The
# dashboard itself is same-origin, and its session cookies are never sent
# cross-site, so this only matters if the API is split out.
CLIENT_ORIGIN=http://localhost:5173

# --- Sign-in methods ---
# Username + password is always on. The one-time-code methods below are fully
# built but OFF until set to "true" (no code change or client rebuild needed):
#   Email OTP: first configure custom SMTP in Supabase -> Auth -> SMTP.
#   Phone OTP: first enable the Phone provider in Supabase -> Auth -> Providers
#              with Twilio (WhatsApp needs an approved WhatsApp sender).
AUTH_EMAIL_OTP_ENABLED=
AUTH_PHONE_OTP_ENABLED=
# "whatsapp" (default) or "sms".
AUTH_PHONE_OTP_CHANNEL=

# --- Petpooja webhook (Global API Documentation.pdf) ---
# Petpooja sends a static token in every payload's "token" field. Set this to
# that value and any request without it is rejected with 401 (spoofed orders
# can't be injected). If unset, the webhook accepts unauthenticated requests
# and logs a warning -- see WEBHOOK_AUTH_REQUIRED.
PETPOOJA_WEBHOOK_TOKEN=

# Set to "true" to make the webhooks fail closed when their token env var is
# missing (recommended once both tokens are configured).
WEBHOOK_AUTH_REQUIRED=

# --- GoSelfServe inbound order-push webhook ---
# Optional. GoSelfServe pushes orders to us since we can't call their order
# APIs directly. Their Swagger doesn't document an auth contract for this
# direction, so this is our own shared secret -- give it to GoSelfServe and
# ask them to send it back on every push as the "x-webhook-token" header, an
# "Authorization: Bearer" header, or a ?token= query parameter on the URL.
# Leave empty to accept pushes unauthenticated (logs a warning).
GOSELFSERVE_WEBHOOK_TOKEN=

# --- GoSelfServe outbound order-status sync ---
# Confirmed from their live Swagger (https://orderservice.qsr.goselfserve.in/orders-json).
# Leave the two credential values empty to leave the sync inactive
# (orders are recorded with goselfserveSyncStatus: "not_configured").
GOSELFSERVE_BASE_URL=https://orderservice.qsr.goselfserve.in
GOSELFSERVE_API_TOKEN=
GOSELFSERVE_API_KEY=

# --- Ask Anything (Gemini) ---
# Server-side only -- read in server/src/entities/ramesh/gemini.ts. Get a key
# from https://aistudio.google.com/apikey. Never prefix with VITE_ (that would
# bundle it into the browser). Leave empty to leave Ask Anything showing its
# "not set up yet" state instead of crashing or faking a response.
GEMINI_API_KEY=
# Optional. Defaults to "gemini-flash-latest" if unset.
GEMINI_MODEL=
