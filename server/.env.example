# Copy this file to server/.env for local development.
# In production, set these as environment variables in the hosting
# dashboard instead -- never commit a real .env file with actual secrets.

# --- Server ---
# PORT is only read by server/src/index.ts's app.listen() (local dev / Render
# entry point). It has no effect on Vercel, which invokes api/index.ts
# directly and manages the listening port itself.
PORT=4300
# On Vercel the frontend and API are same-origin (see vercel.json), so
# browser requests from the dashboard never hit this check at all. Set this
# explicitly in production (Render's env vars, and Vercel's if the frontend
# is ever served from a different origin than the API) rather than relying
# on the code's allow-all fallback when it's unset -- see server/src/app.ts.
CLIENT_ORIGIN=http://localhost:5173

# --- Database (Stage 3: PostgreSQL / Supabase) ---
# Required. Prefer Supabase's connection pooler (Supavisor) connection
# string over the direct connection string -- its host contains
# "pooler.supabase.com" and it typically uses port 6543. The pooler
# multiplexes many short-lived clients over a smaller number of real
# Postgres backend connections, which matters once this API runs behind
# Vercel serverless functions (Stage 4): many concurrent function instances
# each opening a direct connection would otherwise exhaust Supabase's
# connection limit quickly. For local development, any valid Postgres
# connection string works, e.g. a local `postgres://postgres:postgres@
# localhost:5432/postgres` (append `?sslmode=disable` for a local Postgres
# with no TLS listener).
DATABASE_URL=

# Optional pool tuning (server/src/db/client.ts). Defaults are sized for a
# long-lived process (Render/local dev). On Vercel, each warm serverless
# instance holds its own pool, so set this LOW (e.g. 1-2) in the Vercel
# project's environment variables when using the Supavisor pooler above --
# Supavisor is what actually multiplexes connections across many concurrent
# function instances; this app's own pool just needs to avoid opening more
# connections per instance than Supavisor expects from one client.
# PG_POOL_MAX=10
# PG_POOL_IDLE_TIMEOUT_MS=30000
# PG_POOL_CONNECT_TIMEOUT_MS=10000

# Schema is owned entirely by supabase/migrations/ -- this app never
# creates or alters tables at startup. Apply migrations with the Supabase
# CLI or dashboard before starting the server against a fresh database.
#
# (Removed: DATA_DIR -- SQLite's file-based storage no longer exists in the
# PostgreSQL runtime configuration. The Stage 2 SQLite->Postgres migration
# tool at server/src/db/migrate-sqlite-to-postgres.ts still uses SQLITE_PATH
# to locate the production app.db file when migrating historical data; that
# is a separate, standalone script and is documented in its own usage
# comments, not part of the running application's configuration.)

# --- Petpooja webhook (Global API Documentation.pdf) ---
# Optional. The webhook is non-authenticated by default; only set this if
# Petpooja is configured to send a static token back in the payload's "token"
# field, and it must match exactly or the webhook responds 401.
PETPOOJA_WEBHOOK_TOKEN=

# --- GoSelfServe inbound order-push webhook ---
# Optional. GoSelfServe pushes orders to us since we can't call their order
# APIs directly. Their Swagger doesn't document an auth contract for this
# direction, so this is our own shared secret -- give it to GoSelfServe and
# ask them to send it back as the "x-webhook-token" header on every push.
# Leave empty to accept pushes unauthenticated.
GOSELFSERVE_WEBHOOK_TOKEN=

# --- GoSelfServe outbound order-status sync ---
# Confirmed from their live Swagger (https://orderservice.qsr.goselfserve.in/orders-json).
# Leave the two credential values empty to leave the sync inactive
# (orders are recorded with goselfserveSyncStatus: "not_configured").
GOSELFSERVE_BASE_URL=https://orderservice.qsr.goselfserve.in
GOSELFSERVE_API_TOKEN=
GOSELFSERVE_API_KEY=
