{
  "name": "server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/db/seed/run.ts",
    "migrate:dry-run": "tsx src/db/migrate-sqlite-to-postgres.ts --mode=dry-run",
    "migrate": "tsx src/db/migrate-sqlite-to-postgres.ts --mode=migrate",
    "migrate:verify": "tsx src/db/migrate-sqlite-to-postgres.ts --mode=verify"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
